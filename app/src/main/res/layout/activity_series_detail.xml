<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_background"
    android:descendantFocusability="afterDescendants"
    android:fillViewport="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/ivBanner"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:scaleType="centerCrop"
            app:layout_constraintDimensionRatio="21:9"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:background="@drawable/bg_player_controls"
            app:layout_constraintBottom_toBottomOf="@id/ivBanner"
            app:layout_constraintEnd_toEndOf="@id/ivBanner"
            app:layout_constraintStart_toStartOf="@id/ivBanner"
            app:layout_constraintTop_toTopOf="@id/ivBanner" />

        <!-- Back button on banner -->
        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_favorite_badge"
            android:contentDescription="@string/back"
            android:foreground="@drawable/bg_circle_focused"
            android:padding="10dp"
            android:src="@drawable/ic_arrow_left"
            app:tint="@color/white"
            app:layout_constraintStart_toStartOf="@id/ivBanner"
            app:layout_constraintTop_toTopOf="@id/ivBanner" />

        <!-- Favorite button on banner -->
        <ImageButton
            android:id="@+id/btnFavorite"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_margin="16dp"
            android:background="@drawable/bg_favorite_badge"
            android:contentDescription="@string/favorite"
            android:foreground="@drawable/bg_circle_focused"
            android:padding="10dp"
            android:src="@drawable/ic_favorite"
            app:tint="@color/white"
            app:layout_constraintEnd_toEndOf="@id/ivBanner"
            app:layout_constraintTop_toTopOf="@id/ivBanner" />

        <LinearLayout
            android:id="@+id/contentLayout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_margin="24dp"
            android:orientation="vertical"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/ivBanner">

            <TextView
                android:id="@+id/tvTitle"
                style="@style/DetailTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvRating"
                    style="@style/DetailMetadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView style="@style/BulletSeparator" />

                <TextView
                    android:id="@+id/tvYear"
                    style="@style/DetailMetadata"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>

            <TextView
                style="@style/DetailSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/plot" />

            <TextView
                android:id="@+id/tvPlot"
                style="@style/DetailBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/DetailSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/cast" />

            <TextView
                android:id="@+id/tvCast"
                style="@style/DetailBody"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />

            <TextView
                style="@style/DetailSectionHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/select_episode" />

            <com.google.android.material.tabs.TabLayout
                android:id="@+id/tabSeasons"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@color/dark_surface"
                android:nextFocusDown="@id/rvEpisodes"
                app:tabIndicatorColor="@color/red_netflix"
                app:tabIndicatorHeight="3dp"
                app:tabMode="scrollable"
                app:tabSelectedTextColor="@color/white"
                app:tabTextColor="@color/gray_text" />

            <!-- Fixed height so RecyclerView can recycle views properly -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvEpisodes"
                android:layout_width="match_parent"
                android:layout_height="400dp"
                android:layout_marginTop="8dp"
                android:nestedScrollingEnabled="false" />
        </LinearLayout>
    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
