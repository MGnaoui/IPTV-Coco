<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.IPTVCoco" parent="Theme.MaterialComponents.NoActionBar">
        <item name="android:windowBackground">@color/dark_background</item>
        <item name="android:colorBackground">@color/dark_background</item>
        <item name="colorPrimary">@color/red_netflix</item>
        <item name="colorPrimaryVariant">@color/red_netflix_dark</item>
        <item name="colorAccent">@color/red_netflix</item>
        <item name="android:textColorPrimary">@color/white</item>
        <item name="android:textColorSecondary">@color/gray_text</item>
        <item name="android:statusBarColor">@color/dark_background</item>
        <item name="android:navigationBarColor">@color/dark_background</item>
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowNoTitle">true</item>
    </style>

    <style name="Theme.IPTVCoco.Fullscreen" parent="Theme.IPTVCoco">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
        <item name="android:windowBackground">@color/black</item>
    </style>

    <style name="SearchEditText" parent="Widget.AppCompat.EditText">
        <item name="android:background">@drawable/bg_search</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textColorHint">@color/gray_text</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:textSize">14sp</item>
        <item name="android:drawableStart">@drawable/ic_search</item>
        <item name="android:drawablePadding">8dp</item>
        <item name="android:imeOptions">actionSearch</item>
        <item name="android:singleLine">true</item>
    </style>

    <style name="NetflixButton" parent="Widget.MaterialComponents.Button">
        <item name="android:backgroundTint">@color/red_netflix</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="NetflixButton.Outlined" parent="Widget.MaterialComponents.Button.OutlinedButton">
        <item name="strokeColor">@color/white</item>
        <item name="android:textColor">@color/white</item>
        <item name="android:textAllCaps">false</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:textSize">14sp</item>
    </style>

    <style name="TabText" parent="TextAppearance.MaterialComponents.Subtitle1">
        <item name="android:textColor">@color/gray_text</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
